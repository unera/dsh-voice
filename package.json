{
  "name": "@dr-co/dsh-voice",
  "version": "0.3.2",
  "description": "A spoken turn for DeepSeek Harness: the voice loop that turns a device recording into a chat answer the phone can speak, the input marker, the reply contract, and — when switched on — the host's own spoken reply, declared as an OGG deliverable of the turn.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./markup": "./markup.mjs",
    "./structure": "./structure.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "markup.mjs",
    "loop.mjs",
    "trace.mjs",
    "audio.mjs",
    "structure.mjs",
    "settings.mjs",
    "reply.mjs",
    "probe.mjs",
    "routes.mjs",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build-client.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unera/dsh-voice.git"
  },
  "homepage": "https://github.com/unera/dsh-voice#readme",
  "bugs": {
    "url": "https://github.com/unera/dsh-voice/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "voice",
    "speech",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "esbuild": "^0.25.9"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  }
}
