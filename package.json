    "index.mjs",
    "markup.mjs",
    "loop.mjs",
    "trace.mjs",
    "audio.mjs",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "docs"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unera/dsh-voice.git"
  },
  "homepage": "https://github.com/unera/dsh-voice#readme",
